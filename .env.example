# Development only. Production ignores this flag, even when true.
NEXT_PUBLIC_SCROLL_DEBUG=false

# Server-only Google Sheet bridge. Never prefix these with NEXT_PUBLIC_.
BOOKING_SHEET_WEB_APP_URL=https://script.google.com/macros/s/AKfycbwJyjRfk3n2R1R_HVK0q4CrS2j_vOQRikeffwH-8KIltGLiEV6Fh36QdCkfrl9_mUbU/exec
BOOKING_SHEET_SECRET=replace-with-a-long-random-secret

# Optional. Free MapTiler key (maptiler.com) for the /routes map tiles; restrict it
# to your domain in the MapTiler dashboard. Without it the map uses OpenStreetMap tiles.
NEXT_PUBLIC_MAPTILER_KEY=
